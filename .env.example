# Optional. Empty keys enable offline routing and deterministic analytical planning.
# Gemini takes precedence if both keys are set. Keep .env private; never paste keys in chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional estimated uncached rates in USD per 1M tokens for the active model.
# Leave blank if unknown. These are user-supplied rates, not an invoice or a free-tier assumption.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
