  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "ETL job records, **not Airflow DAG run history**. `started_at` in the legacy log records completion time; the tables below label it accordingly. Duration is available only for new runs after the instrumentation update. No historical durations or scheduled runs are reconstructed. Latest-state panels ignore the time picker; activity panels use it."
      }
    },
    {
      "title": "Latest recorded result by job (all time)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "\nWITH jobs(source) AS (VALUES ('bot'),('dopa'),('nesdc'),('worldbank'),('policy'),('mart'))\nSELECT j.source, COALESCE(r.status,'not observed') AS status,\n r.started_at AS recorded_at, r.rows_loaded, ROUND(r.duration_ms::numeric/1000,2) AS duration_seconds,\n EXTRACT(EPOCH FROM (now()-r.started_at))/3600 AS hours_since_record\nFROM jobs j LEFT JOIN LATERAL (SELECT * FROM etl_run e WHERE e.source=j.source\n ORDER BY started_at DESC,id DESC LIMIT 1) r ON true ORDER BY j.source",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reference"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      }
    },
    {
      "title": "Recorded job outcomes (selected window)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "SELECT source,status,COUNT(*) AS recorded_runs\nFROM etl_run WHERE $__timeFilter(started_at) GROUP BY source,status ORDER BY source,status",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reference"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      }
    },
    {
      "title": "Recent job records (selected window)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "Raw exception detail is deliberately excluded. Inspect local service logs for diagnosis.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "SELECT started_at AS recorded_at,source,status,rows_loaded,\n ROUND(duration_ms::numeric/1000,2) AS duration_seconds\nFROM etl_run WHERE $__timeFilter(started_at) ORDER BY started_at DESC,id DESC LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reference"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 7
      }
    },
    {
      "title": "Recorded failures (selected window)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "SELECT started_at AS recorded_at,source,status\nFROM etl_run WHERE $__timeFilter(started_at) AND status<>'success' ORDER BY started_at DESC LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations"
