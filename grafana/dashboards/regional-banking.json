    },
    {
      "title": "Last successful source load (all time)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "Successful retrieval is not proof of a newly published source period.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "SELECT source,MAX(started_at) AS last_success_recorded_at\nFROM etl_run WHERE status='success' GROUP BY source ORDER BY source",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
