      },
      "options": {
        "showHeader": true
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 7
      }
    },
    {
      "title": "Job duration p50 / p95 (selected window)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "bank-postgres"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "bank-postgres"
          },
          "rawSql": "SELECT source,COUNT(duration_ms) AS measured_runs,\n percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms)/1000 AS p50_seconds,\n percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms)/1000 AS p95_seconds\nFROM etl_run WHERE $__timeFilter(started_at) GROUP BY source ORDER BY source",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations"
        },
        "overrides": [
